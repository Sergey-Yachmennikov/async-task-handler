# Переменные окружения для docker compose.
# Compose читает этот файл автоматически из каталога проекта.
#
# Значения здесь — для локальной разработки. В реальном развёртывании файл
# с настоящими учётными данными в репозиторий не кладут: его добавляют
# в .gitignore, а секреты передают средствами оркестратора.

# --- PostgreSQL ---
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
# Порт, на котором база доступна с хоста
POSTGRES_PORT=5432

# --- Kafka ---
# Порт внешнего листенера. Меняется вместе с адресом, который брокер сообщает
# клиентам с хоста, — оба места берут значение отсюда
KAFKA_EXTERNAL_PORT=29092

# --- Порты сервисов ---
# Диапазон, а не один порт: при --scale каждый инстанс берёт свой
APP_PORTS=8080-8085
KAFKA_UI_PORT=8090
