<mxfile host="app.diagrams.net" type="device">
  <diagram id="async-task-handler-data-flow" name="Поток данных">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ================= Заголовок ================= -->
        <mxCell id="title" value="Async Task Handler — поток данных" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ================= Внешние источники ================= -->
        <mxCell id="n1" value="REST-клиент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="Внешний продюсер&#10;(kafka-ui, другой сервис)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- ================= Приём: REST → Kafka ================= -->
        <mxCell id="n2" value="TaskController&#10;POST /api/tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="TaskProducer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="180" height="45" as="geometry"/>
        </mxCell>

        <!-- ================= Kafka ================= -->
        <mxCell id="n5" value="topic tasks&#10;3 партиции" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="310" y="180" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="topic tasks.DLT&#10;неисправимые сообщения" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="310" y="360" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- ================= Обработка внутри инстанса ================= -->
        <mxCell id="n7" value="TaskConsumer&#10;валидация + дедупликация по ключу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="180" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="TaskRegistrationService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="295" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="TaskDispatcher&#10;+ TaskClaimService&#10;@Scheduled, захват пачкой&#10;по свободной ёмкости пула" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="395" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="WorkerPool → TaskRunner&#10;работа отрезками" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="TaskStatusUpdater" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="640" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="StuckTaskRecoveryService&#10;@Scheduled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="740" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- ================= База данных ================= -->
        <mxCell id="n13" value="PostgreSQL&#10;&#10;таблица tasks&#10;&#10;NEW → IN_PROGRESS&#10;→ COMPLETED | FAILED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="330" width="200" height="330" as="geometry"/>
        </mxCell>

        <!-- ================= Чтение результата ================= -->
        <mxCell id="n16" value="REST-клиент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="TaskController&#10;GET /api/tasks/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="855" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="TaskQueryService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="857" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- ================= Связи: приём ================= -->
        <mxCell id="e1" value="POST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="публикация&#10;(ответ 202 сразу)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n3" target="n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="чтение consumer group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n5" target="n7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="невалидное&#10;или неразобранное" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="n7" target="n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="валидно и не дубль" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="INSERT status = NEW" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n8" target="n13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= Связи: выполнение ================= -->
        <mxCell id="e9" value="SELECT … FOR UPDATE SKIP LOCKED&#10;UPDATE status = IN_PROGRESS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;startFill=1;" edge="1" parent="1" source="n9" target="n13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="задачи в пул&#10;(после коммита захвата)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="UPDATE progress&#10;промежуточный результат" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n10" target="n13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="итог" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n10" target="n11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="UPDATE COMPLETED | FAILED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n11" target="n13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="IN_PROGRESS старше порога&#10;→ NEW либо FAILED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;startFill=1;dashed=1;" edge="1" parent="1" source="n12" target="n13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= Связи: чтение ================= -->
        <mxCell id="e15" value="GET" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n16" target="n15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n15" target="n14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="SELECT по id&#10;статус, прогресс, результат" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;startFill=1;" edge="1" parent="1" source="n14" target="n13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ================= Пояснения ================= -->
        <mxCell id="note1" value="&lt;b&gt;Масштабирование&lt;/b&gt;&#10;Зелёные компоненты — один инстанс сервиса.&#10;Инстансов может быть N, база у них общая.&#10;Партиции топика распределяются между&#10;консьюмерами группы, а очередь задач —&#10;через FOR UPDATE SKIP LOCKED: два воркера&#10;не могут захватить одну строку." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="890" y="700" width="270" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;Идемпотентность&lt;/b&gt;&#10;Ключ сообщения Kafka сохраняется&#10;в dedup_key с уникальным ограничением.&#10;Повторная доставка отбрасывается." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="890" y="150" width="270" height="90" as="geometry"/>
        </mxCell>

        <!-- ================= Легенда ================= -->
        <mxCell id="legendBox" value="Обозначения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="440" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="внешний потребитель" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="560" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="компонент сервиса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="600" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="топик Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="560" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lg4" value="хранилище состояния" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="600" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lg5" value="пунктир — путь ошибки и восстановления" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="638" width="400" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
