<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="001-create-tasks-table" author="erevan">
        <comment>Таблица задач: состояние, прогресс и результат выполнения</comment>

        <createTable tableName="tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tasks" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Длительность имитации работы воркером, миллисекунды -->
            <column name="duration_ms" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <!-- Промежуточный результат, п.4 ТЗ: 0..100, обновляется по ходу выполнения -->
            <column name="progress" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="result" type="TEXT"/>
            <column name="error_message" type="TEXT"/>

            <!-- Какой инстанс забрал задачу: видно распределение при масштабировании -->
            <column name="worker_id" type="VARCHAR(120)"/>

            <!-- Оптимистичная блокировка на пути обновления статусов -->
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <!-- rollback для createTable Liquibase генерирует сам -->
    </changeSet>

</databaseChangeLog>
