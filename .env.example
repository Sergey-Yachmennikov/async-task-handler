# Шаблон переменных окружения для docker compose.
# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Файл .env в реальном развёртывании секретов не содержит и не коммитится —
# см. .gitignore. Значения ниже те же, что были дев-дефолтами в .env.

# --- PostgreSQL ---
POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me
# Порт, на котором база доступна с хоста
POSTGRES_PORT=5432

# --- Kafka ---
# Порт внешнего листенера. Меняется вместе с адресом, который брокер сообщает
# клиентам с хоста, — оба места берут значение отсюда
KAFKA_EXTERNAL_PORT=29092

# --- Порты сервисов ---
# Диапазон, а не один порт: при --scale каждый инстанс берёт свой
APP_PORTS=8080-8085
KAFKA_UI_PORT=8090
